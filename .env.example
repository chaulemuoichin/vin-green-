# ── Realtime API keys ───────────────────────────────────────────────────────
# AQICN: free token tại https://aqicn.org/api/ (đăng ký ~30 giây)
# Nếu để trống, hệ thống dùng "demo" token với 4 trạm Hà Nội cố định.
AQICN_TOKEN=

# OpenAQ: free token tại https://explore.openaq.org/register
OPENAQ_API_KEY=

# OpenWeather: free tier tại https://openweathermap.org/api (1,000 call/ngày)
OPENWEATHER_API_KEY=

# Google Maps Distance Matrix (tùy chọn - tăng độ chính xác traffic)
GOOGLE_MAPS_API_KEY=

# ── Nguồn dữ liệu nội bộ (tùy chọn) ────────────────────────────────────────
CDSAPI_URL=
CDSAPI_KEY=
CEMS_API_URL=
ALERT_WEBHOOK_URL=
REDIS_URL=

# ── Fire & Satellite (optional — for upwind smoke detection) ───────────────
# NASA FIRMS: free API key tại https://firms.modaps.eosdis.nasa.gov/api/
FIRMS_MAP_KEY=574c47a834cae0aead0af0ab21e2ba6b

# Google Earth Engine: project ID (free for non-commercial)
# Đăng ký tại https://code.earthengine.google.com
GEE_PROJECT_ID=these-streets

# CAMS/Copernicus (optional, Phase 6 only)
CAMS_API_KEY=

# ── Cấu hình ────────────────────────────────────────────────────────────────
USE_LIVE_DATA=true
FORECAST_HORIZON_HOURS=24
CACHE_TTL_SECONDS=1800
ALERT_AQI_THRESHOLD=150
ALERT_PM25_THRESHOLD=55.5
USE_KRIGING=false
ENABLE_PUBLIC_CRAWL=true
ENABLE_OVERPASS=false
SOMO_SITE_IDS=1,39
