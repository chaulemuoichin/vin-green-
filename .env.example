# ── Realtime API keys ───────────────────────────────────────────────────────
# AQICN: free token tại https://aqicn.org/api/ (đăng ký ~30 giây)
# Nếu để trống, hệ thống dùng "demo" token với 4 trạm Hà Nội cố định.
AQICN_TOKEN=

# OpenAQ: free token tại https://explore.openaq.org/register
OPENAQ_API_KEY=

# OpenWeather: free tier tại https://openweathermap.org/api (1,000 call/ngày)
OPENWEATHER_API_KEY=

# Google Maps Distance Matrix (tùy chọn - tăng độ chính xác traffic)
GOOGLE_MAPS_API_KEY=

# ── Nguồn dữ liệu nội bộ (tùy chọn) ────────────────────────────────────────
CDSAPI_URL=
CDSAPI_KEY=
CEMS_API_URL=
ALERT_WEBHOOK_URL=
REDIS_URL=

# ── Cấu hình ────────────────────────────────────────────────────────────────
USE_LIVE_DATA=true
FORECAST_HORIZON_HOURS=24
CACHE_TTL_SECONDS=1800
ALERT_AQI_THRESHOLD=150
ALERT_PM25_THRESHOLD=55.5
USE_KRIGING=false
ENABLE_PUBLIC_CRAWL=true
ENABLE_OVERPASS=false
SOMO_SITE_IDS=1,39

# ── API security ───────────────────────────────────────────────────────────
# CSV of accepted keys for the `X-API-Key` header on /forecast + /alerts.
# When unset, those endpoints are open (development mode). Set in
# production. The Streamlit dashboard does not need a key.
API_KEYS=demo,pitch

# slowapi-format limits (see https://limits.readthedocs.io/). Applied per
# API key (or "anonymous" when no key is sent).
RATE_LIMIT_FORECAST=60/minute
RATE_LIMIT_ALERTS=30/minute

# JWT bearer auth on top of X-API-Key. When JWT_SECRET is unset, the
# /auth/token endpoint returns 503 and only X-API-Key auth is accepted.
# Generate a strong secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_MINUTES=60
JWT_ISSUER=hanoi-air-forecast

# Comma-separated CORS allowed origins for the dashboard / frontend.
CORS_ALLOWED_ORIGINS=http://localhost:8501,http://localhost:8000,http://localhost:3000
